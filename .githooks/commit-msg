#!/bin/sh
# Rejects AI trailers in commit messages. Enable once per clone with:
#   git config core.hooksPath .githooks
msg_file="$1"
if grep -i -E '^(co-authored-by:.*claude|claude-session:)|generated with \[claude code\]' "$msg_file" >/dev/null 2>&1; then
  echo "commit-msg: AI trailers are not allowed (Co-Authored-By: Claude, Claude-Session, or a Claude Code footer). Remove them and commit again." >&2
  exit 1
fi
exit 0
