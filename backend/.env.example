# Environment Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/always_together
REDIS_URL=redis://localhost:6379/0

# Security Settings
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session Settings
SESSION_COOKIE_NAME=session_id
SESSION_MAX_AGE_SECONDS=10800  # 3 hours
SESSION_IDLE_TIMEOUT_SECONDS=1800  # 30 minutes

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Account Lockout
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Cookies: set to true for local development over plain HTTP (omits the
# Secure flag so session cookies work on http://localhost). Keep false in
# production behind TLS.
COOKIE_INSECURE=false

# Seed a fresh in-memory store with demo accounts on startup
# (alice@example.com / bob@example.com / admin@example.com). For demos only.
SEED_DEMO_DATA=false

# Application
APP_NAME=Always Together API
DEBUG=true
