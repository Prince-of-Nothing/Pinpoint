# Copy to .env and adjust. Never commit a real .env file.

ENVIRONMENT=development
DEBUG=false
APP_NAME=Always Together API

# Python backend database and cache.
DATABASE_URL=postgresql+psycopg://app_runtime:local-dev-runtime@localhost:5432/always_together
MIGRATION_DATABASE_URL=postgresql+psycopg://always_together:local-dev-only@localhost:5432/always_together
REDIS_URL=redis://localhost:6379/0

# Go backend persistence: memory (default, per-process) or postgres.
# With DB_DRIVER=postgres, DATABASE_URL must be a plain pgx-compatible URL
# (e.g. postgresql://postgres:postgres@localhost:5432/always_together) — the
# +psycopg scheme above is Python-only. Unreachable postgres falls back to
# memory with a logged warning.
DB_DRIVER=memory

# Generate a unique random value for each deployment.
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_SECONDS=10800
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_COOKIE_NAME=session_id

# Python uses COOKIE_SECURE; Go uses the inverse COOKIE_INSECURE setting.
COOKIE_SECURE=true
COOKIE_INSECURE=false

LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

LOCATION_LIVE_SECONDS=300
LOCATION_DEAD_SECONDS=3600

# Comma-separated. Leave empty when the Python web client is served by the API.
ALLOWED_ORIGINS=

# Go demo settings. Keep disabled outside local demonstrations.
SEED_DEMO_DATA=false
