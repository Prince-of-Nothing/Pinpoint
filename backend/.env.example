# Environment Configuration
# Copy to .env and adjust. Secrets are intentionally absent from the repo;
# production refuses to start without a real SECRET_KEY (>= 32 chars).

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/always_together
REDIS_URL=redis://localhost:6379/0

# development | testing | production
ENVIRONMENT=development

# Security Settings
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session Settings
SESSION_COOKIE_NAME=session_id
SESSION_MAX_AGE_SECONDS=10800
SESSION_IDLE_TIMEOUT_SECONDS=1800

# Rate Limiting (memory = per process; use redis with multiple workers)
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Account Lockout
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

# CORS / host allowlist (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Application
APP_NAME=Always Together API
DEBUG=false
# Interactive API docs (/docs, /redoc) — always disabled when ENVIRONMENT=production
ENABLE_DOCS=true
