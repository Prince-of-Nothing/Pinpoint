# Pinpoint — example environment (copy to .env; never commit real secrets)

# ---------------------------------------------------------------------------
# OSM services — self-host in production (ADR-0011). The public URLs below are
# demo defaults only; set your own infrastructure URLs before real traffic.
# See docs/OSM_POLICY.md.
# ---------------------------------------------------------------------------
PINPOINT_NOMINATIM_URL=https://nominatim.openstreetmap.org
PINPOINT_OSRM_URL=https://router.project-osrm.org
PINPOINT_OVERPASS_URL=https://overpass-api.de/api/interpreter
# Tile template, e.g. https://tiles.example.com/{z}/{x}/{y}.png
PINPOINT_TILE_URL=
# Optional CARTO key (only for the demo CARTO fallback)
CARTO_API_KEY=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
BIND_ADDR=127.0.0.1:8000
# Empty = in-memory demo mode; set for Postgres persistence.
DATABASE_URL=
# Server session limits: sliding idle minutes and absolute ceiling in days.
PINPOINT_SESSION_IDLE_MINUTES=720
PINPOINT_SESSION_MAX_DAYS=30
# OAuth 2.0 sign-in (Google) — optional. Empty disables the buttons and routes.
# Register the redirect URI {PINPOINT_PUBLIC_URL}/api/v1/auth/oauth/google/callback
# in the Google console before enabling this.
PINPOINT_OAUTH_GOOGLE_CLIENT_ID=
PINPOINT_OAUTH_GOOGLE_CLIENT_SECRET=
PINPOINT_PUBLIC_URL=http://localhost:8000
# GitHub OAuth (optional). Redirect URI: {PINPOINT_PUBLIC_URL}/api/v1/auth/oauth/github/callback
PINPOINT_OAUTH_GITHUB_CLIENT_ID=
PINPOINT_OAUTH_GITHUB_CLIENT_SECRET=
# Column-encryption KEK for private notes/photos (base64 32 bytes) and the blind-index key. REQUIRED when DATABASE_URL is set: the server refuses to start without it. Generate with `openssl rand -base64 32`. Keep the KEK backed up with the database; ADR-0010/ADR-0025.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# ---------------------------------------------------------------------------
# Client
# ---------------------------------------------------------------------------
PINPOINT_BACKEND=http://localhost:8000
# Optional deterministic GPS fix for dev/testing: "lat,lon,acc" or JSON.
PINPOINT_GPS_FIX=

# ---------------------------------------------------------------------------
# Database passwords (required by docker-compose; there are no defaults).
# Generate each one with a password manager or `openssl rand -base64 32`.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
AUTH_DB_PWD=
USERS_DB_PWD=
LOCATIONS_DB_PWD=
MESSAGES_DB_PWD=
DIAG_DB_PWD=
# Only for the HA overlay (docker-compose.ha.yml).
POSTGRES_REPL_PASSWORD=

# Passphrase that encrypts the db-backup service's dumps (required by docker-compose) and scripts/backup-db.ps1. Not read by the server.
# Never commit it. Keep it apart from the backups.
PINPOINT_BACKUP_PASSPHRASE=

# ---------------------------------------------------------------------------
# Public HTTPS (docker compose --profile public up -d)
# ---------------------------------------------------------------------------
# Hostname whose DNS points at this server. Caddy obtains the certificate.
PINPOINT_DOMAIN=

# Photo notes stored per account (defaults: 200 photos, 500 MB).
# PHOTO_NOTE_MAX_COUNT=200
# PHOTO_NOTE_MAX_MB=500
