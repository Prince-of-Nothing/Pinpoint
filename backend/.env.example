# Copy to .env and adjust. Never commit a real .env file.

ENVIRONMENT=development          # development | test | production
DEBUG=false

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/always_together
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=1440

# Set to false only for plain-http local development on a non-localhost host
COOKIE_SECURE=true

LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15

RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis        # redis | memory

LOCATION_LIVE_SECONDS=300
LOCATION_DEAD_SECONDS=3600

# Comma-separated; leave empty when the web client is served by the API itself
ALLOWED_ORIGINS=
